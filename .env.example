NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Required in production: UUID of the archive owner (relationship_settings.owner_id)
SITE_OWNER_ID=

# Optional: one-time bootstrap password when access_hash is not yet set (remove after first unlock)
SITE_BOOTSTRAP_PASSWORD=

# Optional: used by scripts/seed-relationship.ts
SEED_OWNER_ID=

# Google Drive via Apps Script gateway (no Studio OAuth)
GAS_WEB_APP_URL=
GAS_SHARED_SECRET=
GAS_ROOT_FOLDER_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000

BIRTHDAY_ACCESS_HASH=
# Required for partner unlock cookie (HMAC). Use a long random string in production.
SESSION_SIGNING_SECRET=

AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# Optional: set true only if the model supports image_url (most Groq text models do not)
AI_VISION=false
# Optional: force OpenAI-style json_object mode (Groq defaults off)
AI_JSON_MODE=
NEXT_PUBLIC_APP_NAME=OURS
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh-CN
